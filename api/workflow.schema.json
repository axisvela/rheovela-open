{
  "$id": "https://github.com/axisvela/rheovela-open/blob/wave20-open/api/workflow.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowDefinition",
  "description": "RHEOVELA WorkflowDefinition contract (schema_version=1). Compile target of the RHEO IR DSL and input to `rheo workflow define`.",
  "type": "object",
  "additionalProperties": true,
  "required": ["workflow_id", "title", "source", "stages", "transitions"],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "assignee_spec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["actor", "role", "capability", "open"]
              },
              "actor_id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "owner_skill": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "delegatee"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["actor", "role", "capability"]
        },
        "delegatee": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "budget": { "type": "integer" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "gate": {
            "$ref": "#/definitions/gate"
          },
          "delegation": {
            "$ref": "#/definitions/delegation"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "migration_policy": {
            "type": "string",
            "enum": ["preserve", "ignore", "compensate"]
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string"
          }
        }
      }
    },
    "compensations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/compensation"
      }
    },
    "bpmn": {
      "$ref": "#/definitions/bpmn"
    }
  },
  "definitions": {
    "bpmn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnNode" }
        },
        "internal_flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnFlow" }
        },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnParticipant" }
        },
        "message_flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnMessageFlow" }
        },
        "lanes": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnLane" }
        },
        "data_objects": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnDataObject" }
        },
        "diagram": {
          "$ref": "#/definitions/bpmnDiagram"
        }
      }
    },
    "bpmnNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "element"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "element": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "event_kind": { "type": "string" },
        "attached_to": { "type": "string" },
        "parent_subprocess": { "type": "string" }
      }
    },
    "bpmnFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "condition": { "type": "string" },
        "parent_subprocess": { "type": "string" }
      }
    },
    "bpmnParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" }
      }
    },
    "bpmnMessageFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "bpmnLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "node_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "bpmnDataObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    "bpmnDiagram": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "plane_id": { "type": "string" },
        "shapes": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnShape" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnEdge" }
        }
      }
    },
    "bpmnShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "bpmn_element": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "bpmnEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "bpmn_element": { "type": "string" },
        "waypoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnPoint" }
        }
      }
    },
    "bpmnPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["for_activity"],
      "properties": {
        "for_activity": {
          "type": "string",
          "minLength": 1
        },
        "compensate_with": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires"],
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
