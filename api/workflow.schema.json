{
  "$id": "https://github.com/axisvela/rheovela-open/blob/wave20-open/api/workflow.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowDefinition",
  "description": "RHEOVELA WorkflowDefinition contract (schema_version=1). Compile target of the RHEO IR DSL and input to `rheo workflow define`.",
  "type": "object",
  "additionalProperties": true,
  "required": ["workflow_id", "title", "source", "stages", "transitions"],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "assignee_spec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["actor", "role", "capability", "open"]
              },
              "actor_id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "owner_skill": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "delegatee"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["actor", "role", "capability"]
        },
        "delegatee": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "budget": { "type": "integer" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "gate": {
            "$ref": "#/definitions/gate"
          },
          "delegation": {
            "$ref": "#/definitions/delegation"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "migration_policy": {
            "type": "string",
            "enum": ["preserve", "ignore", "compensate"]
          },
          "effect_key": {
            "type": "string"
          },
          "timeout": {
            "type": "string"
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string"
          }
        }
      }
    },
    "compensations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/compensation"
      }
    },
    "bpmn": {
      "$ref": "#/definitions/bpmn"
    }
  },
  "definitions": {
    "bpmn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnNode" }
        },
        "flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnFlow" }
        },
        "internal_flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnFlow" }
        },
        "processes": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnProcess" }
        },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnParticipant" }
        },
        "message_flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnMessageFlow" }
        },
        "lanes": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnLane" }
        },
        "data_objects": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnDataObject" }
        },
        "data_stores": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnDataStore" }
        },
        "data_store_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnDataStoreRef" }
        },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnProperty" }
        },
        "item_definitions": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnItemDefinition" }
        },
        "data_inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnDataInput" }
        },
        "data_outputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnDataOutput" }
        },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnResource" }
        },
        "categories": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnCategory" }
        },
        "event_definitions": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnEventDefinition" }
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnArtifact" }
        },
        "process_io_specification": { "$ref": "#/definitions/bpmnIOSpecification" },
        "collaboration": { "$ref": "#/definitions/bpmnCollaboration" },
        "extension_elements": { "type": "array", "items": { "$ref": "#/definitions/bpmnExtension" } },
        "process_extensions": { "type": "array", "items": { "$ref": "#/definitions/bpmnExtension" } },
        "documentation": { "type": "array", "items": { "type": "string" } },
        "imports": { "type": "array", "items": { "$ref": "#/definitions/bpmnImport" } },
        "relationships": { "type": "array", "items": { "$ref": "#/definitions/bpmnRelationship" } },
        "messages": { "type": "array", "items": { "$ref": "#/definitions/bpmnMessage" } },
        "signals": { "type": "array", "items": { "$ref": "#/definitions/bpmnSignal" } },
        "errors": { "type": "array", "items": { "$ref": "#/definitions/bpmnError" } },
        "escalations": { "type": "array", "items": { "$ref": "#/definitions/bpmnEscalation" } },
        "interfaces": { "type": "array", "items": { "$ref": "#/definitions/bpmnInterface" } },
        "end_points": { "type": "array", "items": { "$ref": "#/definitions/bpmnEndPoint" } },
        "choreographies": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnChoreography" }
        },
        "data_associations": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnDataAssociation" }
        },
        "diagram": {
          "$ref": "#/definitions/bpmnDiagram"
        }
      }
    },
    "bpmnNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "element"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "element": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "event_kind": { "type": "string" },
        "attached_to": { "type": "string" },
        "parent_subprocess": { "type": "string" },
        "process_id": { "type": "string" },
        "gateway_direction": { "type": "string" },
        "event_gateway_type": { "type": "string" },
        "instantiate": { "type": "boolean" },
        "default_flow": { "type": "string" },
        "cancel_activity": { "type": "boolean" },
        "parallel_multiple": { "type": "boolean" },
        "direction": { "type": "string" },
        "event_definitions": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnEventDefinition" }
        },
        "called_element": { "type": "string" },
        "triggered_by_event": { "type": "boolean" },
        "is_for_compensation": { "type": "boolean" },
        "ordering": { "type": "string" },
        "cancel_remaining_instances": { "type": "boolean" },
        "method": { "type": "string" },
        "completion_quantity": { "type": "string" },
        "start_quantity": { "type": "string" },
        "loop": { "$ref": "#/definitions/bpmnLoop" },
        "event_definition_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resource_roles": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnResourceRole" }
        },
        "io_specification": { "$ref": "#/definitions/bpmnIOSpecification" },
        "activation_condition": { "type": "string" },
        "ad_hoc_completion_condition": { "type": "string" },
        "documentation": { "type": "array", "items": { "type": "string" } },
        "extension_elements": { "type": "array", "items": { "$ref": "#/definitions/bpmnExtension" } },
        "is_interrupting": { "type": "boolean" }
      }
    },
    "bpmnLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "is_sequential": { "type": "boolean" },
        "loop_cardinality": { "type": "string" },
        "completion_condition": { "type": "string" },
        "collection": { "type": "string" },
        "element_variable": { "type": "string" },
        "test_before": { "type": "boolean" },
        "loop_maximum": { "type": "string" },
        "loop_condition": { "type": "string" },
        "behavior": { "type": "string" },
        "one_behavior_event_ref": { "type": "string" },
        "none_behavior_event_ref": { "type": "string" }
      }
    },
    "bpmnEventDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "minLength": 1 },
        "ref": { "type": "string" },
        "name": { "type": "string" },
        "time_date": { "type": "string" },
        "time_duration": { "type": "string" },
        "time_cycle": { "type": "string" },
        "activity_ref": { "type": "string" },
        "wait_for_completion": { "type": "boolean" },
        "condition": { "type": "string" },
        "operation_ref": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "targets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bpmnFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "condition": { "type": "string" },
        "is_immediate": { "type": "boolean" },
        "parent_subprocess": { "type": "string" }
      }
    },
    "bpmnProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "is_executable": { "type": "boolean" },
        "participant": { "type": "string" },
        "documentation": { "type": "array", "items": { "type": "string" } },
        "auditing": { "type": "boolean" },
        "monitoring": { "type": "boolean" }
      }
    },
    "bpmnParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "process_ref": { "type": "string" },
        "multiplicity": { "$ref": "#/definitions/bpmnParticipantMultiplicity" },
        "interface_refs": { "type": "array", "items": { "type": "string" } },
        "end_point_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bpmnParticipantMultiplicity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": "integer" },
        "maximum": { "type": "string" }
      }
    },
    "bpmnChoreography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "participant_refs": { "type": "array", "items": { "type": "string" } },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnChoreographyTask" }
        },
        "message_flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnMessageFlow" }
        }
      }
    },
    "bpmnChoreographyTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "element"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "element": { "type": "string", "minLength": 1 },
        "initiating_participant_ref": { "type": "string" },
        "participant_refs": { "type": "array", "items": { "type": "string" } },
        "message_flow_refs": { "type": "array", "items": { "type": "string" } },
        "loop_type": { "type": "string" },
        "parent_choreography": { "type": "string" },
        "called_choreography_ref": { "type": "string" },
        "participant_associations": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnParticipantAssociation" }
        },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnChoreographyTask" }
        }
      }
    },
    "bpmnDataAssociation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "element", "owner"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "element": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "items": { "type": "string" } },
        "targets": { "type": "array", "items": { "type": "string" } },
        "transformations": { "type": "array", "items": { "type": "string" } },
        "assignments": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnAssignment" }
        }
      }
    },
    "bpmnAssignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    },
    "bpmnMessageFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "message_ref": { "type": "string" }
      }
    },
    "bpmnLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "node_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "bpmnDataObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "ref": { "type": "string" },
        "item_subject_ref": { "type": "string" },
        "is_collection": { "type": "boolean" },
        "data_state": { "type": "string" }
      }
    },
    "bpmnDataStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "item_subject_ref": { "type": "string" },
        "is_unlimited": { "type": "boolean" },
        "capacity": { "type": "string" }
      }
    },
    "bpmnDataStoreRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "data_store_ref": { "type": "string" }
      }
    },
    "bpmnProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "item_subject_ref": { "type": "string" }
      }
    },
    "bpmnItemDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "structure_ref": { "type": "string" },
        "is_collection": { "type": "boolean" }
      }
    },
    "bpmnDataInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "item_subject_ref": { "type": "string" },
        "is_collection": { "type": "boolean" }
      }
    },
    "bpmnDataOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "item_subject_ref": { "type": "string" },
        "is_collection": { "type": "boolean" }
      }
    },
    "bpmnResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" }
      }
    },
    "bpmnResourceRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "element"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "element": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "resource_ref": { "type": "string" },
        "parameter_bindings": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnResourceParameterBinding" }
        },
        "assignment_expression": { "type": "string" }
      }
    },
    "bpmnResourceParameterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parameter_ref": { "type": "string" },
        "expression": { "type": "string" }
      }
    },
    "bpmnIOSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "data_input_refs": { "type": "array", "items": { "type": "string" } },
        "data_output_refs": { "type": "array", "items": { "type": "string" } },
        "input_sets": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnInputSet" }
        },
        "output_sets": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnOutputSet" }
        }
      }
    },
    "bpmnInputSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "data_input_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bpmnOutputSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "data_output_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bpmnCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnCategoryValue" }
        }
      }
    },
    "bpmnCategoryValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "bpmnMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "item_ref": { "type": "string" }
      }
    },
    "bpmnSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "structure_ref": { "type": "string" }
      }
    },
    "bpmnError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "error_code": { "type": "string" },
        "structure_ref": { "type": "string" }
      }
    },
    "bpmnEscalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "escalation_code": { "type": "string" },
        "structure_ref": { "type": "string" }
      }
    },
    "bpmnOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "implementation_ref": { "type": "string" },
        "in_message_ref": { "type": "string" },
        "out_message_ref": { "type": "string" },
        "error_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bpmnInterface": {
