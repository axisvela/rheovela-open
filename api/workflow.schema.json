{
  "$id": "https://github.com/axisrobo/rheovela-open/blob/wave20-open/api/workflow.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowDefinition",
  "description": "RHEOVELA WorkflowDefinition contract (schema_version=1). Compile target of the RHEO IR DSL and input to `rheo workflow define`.",
  "type": "object",
  "additionalProperties": true,
  "required": ["workflow_id", "title", "source", "stages", "transitions"],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "assignee_spec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["actor", "role", "capability", "open"]
              },
              "actor_id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "owner_skill": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gate": {
            "$ref": "#/definitions/gate"
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires"],
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
