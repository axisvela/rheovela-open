{
  "$id": "https://github.com/axisvela/rheovela-open/blob/wave20-open/api/workflow.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowDefinition",
  "description": "RHEOVELA WorkflowDefinition contract (schema_version=1). Compile target of the RHEO IR DSL and input to `rheo workflow define`.",
  "type": "object",
  "additionalProperties": true,
  "required": ["workflow_id", "title", "source", "stages", "transitions"],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "assignee_spec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["actor", "role", "capability", "open"]
              },
              "actor_id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "owner_skill": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "delegatee"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["actor", "role", "capability"]
        },
        "delegatee": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "budget": { "type": "integer" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "gate": {
            "$ref": "#/definitions/gate"
          },
          "delegation": {
            "$ref": "#/definitions/delegation"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "migration_policy": {
            "type": "string",
            "enum": ["preserve", "ignore", "compensate"]
          },
          "effect_key": {
            "type": "string"
          },
          "timeout": {
            "type": "string"
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string"
          }
        }
      }
    },
    "compensations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/compensation"
      }
    },
    "bpmn": {
      "$ref": "#/definitions/bpmn"
    }
  },
  "definitions": {
    "bpmn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnNode" }
        },
        "flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnFlow" }
        },
        "internal_flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnFlow" }
        },
        "processes": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnProcess" }
        },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnParticipant" }
        },
        "message_flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnMessageFlow" }
        },
        "lanes": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnLane" }
        },
        "data_objects": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnDataObject" }
        },
        "choreographies": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnChoreography" }
        },
        "data_associations": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnDataAssociation" }
        },
        "diagram": {
          "$ref": "#/definitions/bpmnDiagram"
        }
      }
    },
    "bpmnNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "element"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "element": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "event_kind": { "type": "string" },
        "attached_to": { "type": "string" },
        "parent_subprocess": { "type": "string" },
        "process_id": { "type": "string" },
        "gateway_direction": { "type": "string" },
        "event_gateway_type": { "type": "string" },
        "instantiate": { "type": "boolean" },
        "default_flow": { "type": "string" },
        "cancel_activity": { "type": "boolean" },
        "parallel_multiple": { "type": "boolean" },
        "direction": { "type": "string" },
        "event_definitions": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnEventDefinition" }
        },
        "called_element": { "type": "string" },
        "triggered_by_event": { "type": "boolean" },
        "is_for_compensation": { "type": "boolean" },
        "loop": { "$ref": "#/definitions/bpmnLoop" }
      }
    },
    "bpmnLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "is_sequential": { "type": "boolean" },
        "loop_cardinality": { "type": "string" },
        "completion_condition": { "type": "string" },
        "collection": { "type": "string" },
        "element_variable": { "type": "string" },
        "test_before": { "type": "boolean" },
        "loop_maximum": { "type": "string" },
        "loop_condition": { "type": "string" }
      }
    },
    "bpmnEventDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "ref": { "type": "string" },
        "name": { "type": "string" },
        "time_date": { "type": "string" },
        "time_duration": { "type": "string" },
        "time_cycle": { "type": "string" },
        "activity_ref": { "type": "string" },
        "wait_for_completion": { "type": "boolean" },
        "condition": { "type": "string" }
      }
    },
    "bpmnFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "condition": { "type": "string" },
        "parent_subprocess": { "type": "string" }
      }
    },
    "bpmnProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "is_executable": { "type": "boolean" },
        "participant": { "type": "string" }
      }
    },
    "bpmnParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "process_ref": { "type": "string" },
        "multiplicity": { "$ref": "#/definitions/bpmnParticipantMultiplicity" }
      }
    },
    "bpmnParticipantMultiplicity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": "integer" },
        "maximum": { "type": "string" }
      }
    },
    "bpmnChoreography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "participant_refs": { "type": "array", "items": { "type": "string" } },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnChoreographyTask" }
        },
        "message_flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnMessageFlow" }
        }
      }
    },
    "bpmnChoreographyTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "element"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "element": { "type": "string", "minLength": 1 },
        "initiating_participant_ref": { "type": "string" },
        "participant_refs": { "type": "array", "items": { "type": "string" } },
        "message_flow_refs": { "type": "array", "items": { "type": "string" } },
        "loop_type": { "type": "string" },
        "parent_choreography": { "type": "string" },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnChoreographyTask" }
        }
      }
    },
    "bpmnDataAssociation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "element", "owner"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "element": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "items": { "type": "string" } },
        "targets": { "type": "array", "items": { "type": "string" } },
        "transformations": { "type": "array", "items": { "type": "string" } },
        "assignments": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnAssignment" }
        }
      }
    },
    "bpmnAssignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    },
    "bpmnMessageFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "message_ref": { "type": "string" }
      }
    },
    "bpmnLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "node_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "bpmnDataObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    "bpmnDiagram": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "plane_id": { "type": "string" },
        "bpmn_element": { "type": "string" },
        "resolution": { "type": "number" },
        "shapes": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnShape" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnEdge" }
        },
        "label_styles": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnLabelStyle" }
        }
      }
    },
    "bpmnLabel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bounds": { "$ref": "#/definitions/bpmnBounds" },
        "label_style": { "type": "string" }
      }
    },
    "bpmnBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "bpmnLabelStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "font_name": { "type": "string" },
        "font_size": { "type": "number" },
        "font_bold": { "type": "boolean" },
        "font_italic": { "type": "boolean" }
      }
    },
    "bpmnShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "bpmn_element": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "is_expanded": { "type": "boolean" },
        "is_marker_visible": { "type": "boolean" },
        "is_horizontal": { "type": "boolean" },
        "is_message_visible": { "type": "boolean" },
        "participant_band_kind": { "type": "string" },
        "label": { "$ref": "#/definitions/bpmnLabel" }
      }
    },
    "bpmnEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "bpmn_element": { "type": "string" },
        "source_element": { "type": "string" },
        "target_element": { "type": "string" },
        "message_visible_kind": { "type": "string" },
        "waypoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/bpmnPoint" }
        },
        "label": { "$ref": "#/definitions/bpmnLabel" }
      }
    },
    "bpmnPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["for_activity"],
      "properties": {
        "for_activity": {
          "type": "string",
          "minLength": 1
        },
        "compensate_with": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires"],
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
